SOC_PLATFORM_ROOT=/app
OLLAMA_URL=http://host.docker.internal:11434

# Default runtime database
# For local host execution, the project defaults to the containerized Postgres on localhost:5433.
DATABASE_URL=postgresql+psycopg://soc_platform:replace-with-a-long-random-password@localhost:5433/soc_platform
COMPOSE_DATABASE_URL=postgresql+psycopg://soc_platform:replace-with-a-long-random-password@postgres:5432/soc_platform
POSTGRES_HOST_PORT=5433

# SQLite is retained only as a backup/export source.
# Example SQLite runtime override:
# DATABASE_URL=sqlite:///C:/Users/<user>/Downloads/SOC_Automation_Working/splunk-es-backup-toolkit/triage.db

# PostgreSQL container defaults
POSTGRES_DB=soc_platform
POSTGRES_USER=soc_platform
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Use the same password in DATABASE_URL and COMPOSE_DATABASE_URL. Prefer a
# URL-safe password, or percent-encode reserved URL characters.

# The project intentionally uses localhost:5433 by default to avoid collisions with any separately
# installed local PostgreSQL service that may already be listening on 5432.
# If multiple local clones must run on the same machine, choose another host port such as 5434.
