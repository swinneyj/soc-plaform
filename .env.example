SOC_PLATFORM_ROOT=/app
OLLAMA_URL=http://host.docker.internal:11434

# Default local SQLite configuration
DATABASE_URL=sqlite:////app/splunk-es-backup-toolkit/triage.db

# PostgreSQL container defaults
POSTGRES_DB=soc_platform
POSTGRES_USER=soc_platform
POSTGRES_PASSWORD=soc_platform_dev
# Local development compose profile uses trust auth for host connections.

# Example PostgreSQL DATABASE_URL
# Container is exposed on localhost:5433 to avoid collisions with any local PostgreSQL service.
# DATABASE_URL=postgresql+psycopg://soc_platform@localhost:5433/soc_platform