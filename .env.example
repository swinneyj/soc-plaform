SOC_PLATFORM_ROOT=/app
OLLAMA_URL=http://host.docker.internal:11434
# Optional: pin the analysis model tag. If unset, the platform auto-resolves
# the best installed llama3.1 tag at request time.
# OLLAMA_MODEL=llama3.1:latest

# ── Database target (see docs/LOCAL_FIRST_DATABASE.md) ───────────────────
# Local Postgres is the PRIMARY runtime database; the shared Neon project is an
# optional mirror. Leave DATABASE_URL UNSET to get the local default
# (127.0.0.1:5432/soc_platform) — that is the normal case, so no DATABASE_URL
# line belongs in this file.
#
# SOC_DB_TARGET=shared       # opt into the shared mirror (scripts/dev --shared)
# SHARED_DATABASE_URL=...    # the Neon URL; credential — keychain/BWS, not committed
# LOCAL_DATABASE_URL=postgresql+psycopg://soc_platform@127.0.0.1:5433/soc_platform
#                            # override the local URL (e.g. the compose port)
#
# An explicit DATABASE_URL always wins over SOC_DB_TARGET (operator intent).
# `bws run` injects DATABASE_URL too, which is why the launchers only use BWS
# for the shared target — otherwise the vault silently overrides local.

# PostgreSQL container defaults (docker compose only; the host service uses 5432)
COMPOSE_DATABASE_URL=postgresql+psycopg://soc_platform:replace-with-a-long-random-password@postgres:5432/soc_platform
POSTGRES_HOST_PORT=5433

# PostgreSQL container defaults
POSTGRES_DB=soc_platform
POSTGRES_USER=soc_platform
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Use the same password in COMPOSE_DATABASE_URL and POSTGRES_PASSWORD. Prefer a
# URL-safe password, or percent-encode reserved URL characters.

# 5433 is the compose container's HOST port only — chosen so it cannot collide
# with the Homebrew postgresql@16 service the platform uses as its primary
# database on 5432. If multiple local clones must run containers on the same
# machine, pick another host port such as 5434.

# Phase 3 Splunk connector (read-only). The default backend is the deterministic
# mock — zero credentials needed. SEARCH_BACKEND=splunk requires BOTH vars below
# (BWS/keychain-injected; unconfigured splunk mode fails loudly at construction).
SEARCH_BACKEND=mock
# SPLUNK_URL=https://splunk.example.com:8089
# SPLUNK_TOKEN=replace-with-a-read-only-bearer-token
# SPLUNK_CA_BUNDLE=/path/to/splunk-ca.pem   # pin an internal/self-signed CA (preferred)
# SPLUNK_VERIFY_TLS=false                   # last resort only; shown by /api/splunk/search-status

# Auth mode (C1B + SEC-01) — inert until AUTH_MODE is set; see
# docs/SESSION_AUTH_PLAN.md. One of: session | proxy.
# AUTH_MODE=session
# SESSION_SECURE=1
#
# AUTH_MODE=proxy trusts an identity header stamped by a reverse proxy that has
# already authenticated the user. The header is honored ONLY when the TCP peer
# is inside SOC_TRUSTED_PROXY_CIDRS (unset = trust nobody, fail closed), and its
# value must be a users.id that resolves to an ACTIVE account.
# AUTH_MODE=proxy
# SOC_PROXY_USER_HEADER=X-Auth-Request-User   # default shown; one header only
# SOC_TRUSTED_PROXY_CIDRS=127.0.0.1/32,10.42.0.0/16

# Serving + admission knobs (optional; defaults shown)
# API_BIND=127.0.0.1        # loopback by default; LAN/Tailscale exposure must be deliberate
# MAX_BODY_BYTES=10485760   # 10 MiB global body cap (paste keeps its own tighter 5 MiB)
# AUTH_ALLOW_QUERY_KEY=1    # re-enables ?api_key= for smoke tests; leave unset (header-only)

# Audit stream file output (task 4): soc.audit JSON lines are ALSO written
# here (stdout always stays on). The K8s sidecar in
# k8s/soc-api-deployment.yaml tails exactly this path off a shared emptyDir.
# AUDIT_LOG_FILE=/var/log/soc/audit.json
