#!/usr/bin/env bash
# scripts/next — "what do I have to do?" answered automatically.
#
# Read-only: inspects repo/env/git state and prints the remaining human
# actions with exact commands. Run it anytime; it never changes anything.

set -uo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

OK="  ✓ "
TODO="  ▶ "
WAIT="  ⏳ "

echo "── SOC Platform: what's left for YOU ──────────────────"

# 1. BWS onboarding -------------------------------------------------------
if grep -qE '^BWS_ACCESS_TOKEN=.+' .env 2>/dev/null; then
    echo "${OK}BWS: token in .env — run scripts/pull-secrets if you haven't, then scripts/dev"
elif [ -n "${BWS_INVITE_HINT:-}" ]; then
    echo "${WAIT}BWS: invite pending (coworker) — when it lands, see .env.bws.template (10 min)"
else
    echo "${WAIT}BWS: waiting on coworker's org invite/token → then: accept invite, create"
    echo "        machine account 'dalton-laptop', generate token, put it in .env as"
    echo "        BWS_ACCESS_TOKEN=...  (walkthrough in .env.bws.template)"
fi

# 2. Database target -----------------------------------------------------
# Local Postgres is primary; the shared Neon project is an optional mirror
# (docs/LOCAL_FIRST_DATABASE.md). Report the resolved target from the same
# module the launchers use — never re-derive it by grepping .env, which
# reported a false "waiting on Neon URL" while the platform was fine.
NEXT_PY=".venv314/bin/python"
[ -x "$NEXT_PY" ] || NEXT_PY=".venv/bin/python"
# Mirror the launchers' keychain fallback so a `SOC_DB_TARGET=shared` shell
# reports the real target instead of a resolution error.
if [ "${SOC_DB_TARGET:-}" = "shared" ] && [ -z "${SHARED_DATABASE_URL:-}" ]; then
    SHARED_DATABASE_URL="$(bash scripts/secrets-keychain get SHARED_DATABASE_URL 2>/dev/null \
        || bash scripts/secrets-keychain get DATABASE_URL 2>/dev/null || true)"
    [ -n "$SHARED_DATABASE_URL" ] && export SHARED_DATABASE_URL
fi
DB_SUMMARY=""
DB_ERR=""
if [ -x "$NEXT_PY" ]; then
    DB_SUMMARY="$($NEXT_PY -m db.target --summary 2>&1)" || { DB_ERR="$DB_SUMMARY"; DB_SUMMARY=""; }
fi
DB_PING=""
[ -n "$DB_SUMMARY" ] && DB_PING="$($NEXT_PY -m db.target --ping 2>/dev/null)"
case "$DB_SUMMARY" in
    shared*|*neon.tech*) SHARED_ACTIVE=1 ;;
    *) SHARED_ACTIVE=0 ;;
esac
if [ -n "$DB_SUMMARY" ] && [ "$SHARED_ACTIVE" -eq 0 ]; then
    echo "${OK}Database: local-first — ${DB_SUMMARY}"
    [ -n "$DB_PING" ] && echo "        ${DB_PING}"
    echo "        shared mirror on demand: scripts/start --shared (snapshot: scripts/mirror_db pull)"
elif [ -n "$DB_SUMMARY" ]; then
    echo "${OK}Database: running against the SHARED mirror — ${DB_SUMMARY}"
    echo "        drop SOC_DB_TARGET/DATABASE_URL to return to local (the primary)"
elif [ ! -x "$NEXT_PY" ]; then
    echo "${WAIT}Database: no interpreter found (.venv314/.venv) — run scripts/start --check"
else
    echo "${WAIT}Database: target unresolved — ${DB_ERR:-see scripts/start --check}"
    echo "        (shared target needs SHARED_DATABASE_URL; a missing local server means: brew services start postgresql@16)"
fi
# The shared URL is a credential: report presence only, never the value.
SHARED_URL_PRESENT=0
if [ -n "${SHARED_DATABASE_URL:-}" ]; then
    SHARED_URL_PRESENT=1
elif bash scripts/secrets-keychain get SHARED_DATABASE_URL >/dev/null 2>&1 \
    || bash scripts/secrets-keychain get DATABASE_URL >/dev/null 2>&1; then
    SHARED_URL_PRESENT=1
fi
if [ "$SHARED_URL_PRESENT" -eq 1 ]; then
    echo "${OK}Mirror credentials: shared URL available (keychain/BWS/env — not printed)"
else
    echo "${WAIT}Mirror credentials: no shared URL yet — local-only until one lands"
    echo "        (call/Signal/BWS — never email/chat; then scripts/secrets-keychain put SHARED_DATABASE_URL)"
fi

# 3. Vercel retirement (deploy.yml deleted Sept 30, 2026) -----------------
echo "${OK}Vercel: deployment retired — project kept on ice (frozen last build)"
echo "        (undeployable from this repo; docs/VERCEL_HANDOFF.md)"

# 4. Dependabot -----------------------------------------------------------
if [ -f .github/dependabot.yml ]; then
    echo "${OK}Dependabot: config committed — just confirm alerts are enabled in repo Settings → Security"
else
    echo "${WAIT}Dependabot: config lands via git; then Settings → Security → Dependabot → Enable"
fi

# 5. API key activation ---------------------------------------------------
# The gate is enforcing (witnessed Oct 5, 2026): API_KEY is injected from
# BWS at launch. It legitimately lives in the keychain rather than .env,
# so check both places before calling it missing.
API_KEY_SOURCE=""
if [ -n "${API_KEY:-}" ] && [ "$API_KEY" != "replace-with-a-long-random-password" ]; then
    API_KEY_SOURCE="environment / .env"
else
    KEY_VALUE="$(bash scripts/secrets-keychain get API_KEY 2>/dev/null)"
    [ -n "$KEY_VALUE" ] && API_KEY_SOURCE="login keychain (injected at launch)"
fi
if [ -n "$API_KEY_SOURCE" ]; then
    echo "${OK}API gate: enforcing — API_KEY available (${API_KEY_SOURCE}); unauthenticated /api/* gets 401"
else
    echo "${WAIT}API gate: API_KEY missing from env AND keychain — gate degrades to a no-op; restore via 'scripts/pull-secrets' (BWS) or 'scripts/secrets-keychain put API_KEY'"
fi

# 6. Hygiene reminders ----------------------------------------------------
[ -f triage.db ] && echo "${WAIT}triage.db reappeared in the tree — it was archived to splunk-es-backup-toolkit/ on Sep 25; investigate why it's back"
echo ""
echo "   (read-only check — nothing was changed. Details: docs/security-remediation-tracker.md)"