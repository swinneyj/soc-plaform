#!/usr/bin/env bash
# scripts/next — "what do I have to do?" answered automatically.
#
# Read-only: inspects repo/env/git state and prints the remaining human
# actions with exact commands. Run it anytime; it never changes anything.

set -uo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

OK="  ✓ "
TODO="  ▶ "
WAIT="  ⏳ "

echo "── SOC Platform: what's left for YOU ──────────────────"

# 1. BWS onboarding -------------------------------------------------------
if grep -qE '^BWS_ACCESS_TOKEN=.+' .env 2>/dev/null; then
    echo "${OK}BWS: token in .env — run scripts/pull-secrets if you haven't, then scripts/dev"
elif [ -n "${BWS_INVITE_HINT:-}" ]; then
    echo "${WAIT}BWS: invite pending (coworker) — when it lands, see .env.bws.template (10 min)"
else
    echo "${WAIT}BWS: waiting on coworker's org invite/token → then: accept invite, create"
    echo "        machine account 'dalton-laptop', generate token, put it in .env as"
    echo "        BWS_ACCESS_TOKEN=...  (walkthrough in .env.bws.template)"
fi

# 2. New Neon URL ---------------------------------------------------------
# DATABASE_URL lives in the launch environment, .env, or the login
# keychain (scripts/start injects it; credential keys live in the
# keychain) — grepping .env alone reported a false "waiting on URL"
# TODO while the platform was already querying Neon.
DB_URL_SOURCE=""
DB_URL_FOREIGN=""
if [ -n "${DATABASE_URL:-}" ]; then
    case "$DATABASE_URL" in
        *neon.tech*) DB_URL_SOURCE="environment" ;;
        *) DB_URL_FOREIGN=1 ;;
    esac
elif grep -qE '^DATABASE_URL=.*neon\.tech' .env 2>/dev/null; then
    DB_URL_SOURCE=".env"
else
    DB_URL_KEY="$(bash scripts/secrets-keychain get DATABASE_URL 2>/dev/null)"
    case "$DB_URL_KEY" in
        "") ;;
        *neon.tech*) DB_URL_SOURCE="login keychain" ;;
        *) DB_URL_FOREIGN=1 ;;
    esac
fi
if [ -n "$DB_URL_SOURCE" ]; then
    echo "${OK}Neon: DATABASE_URL points at Neon ✓ (${DB_URL_SOURCE})"
elif [ -n "$DB_URL_FOREIGN" ]; then
    echo "${WAIT}Neon: DATABASE_URL resolves to a non-Neon host — run scripts/start --check to see which DB is active"
elif grep -qE '^DATABASE_URL=.*neon\.tech' .env.example 2>/dev/null; then
    echo "${WAIT}Neon: new URL in .env.example? — copy it into .env"
else
    echo "${TODO}Neon: when the new URL reaches you (call/Signal/BWS — NOT email/chat):"
    echo "        echo 'DATABASE_URL=<new url>' >> .env"
fi

# 3. Vercel retirement (deploy.yml deleted Sept 30, 2026) -----------------
echo "${OK}Vercel: deployment retired — project kept on ice (frozen last build)"
echo "        (undeployable from this repo; docs/VERCEL_HANDOFF.md)"

# 4. Dependabot -----------------------------------------------------------
if [ -f .github/dependabot.yml ]; then
    echo "${OK}Dependabot: config committed — just confirm alerts are enabled in repo Settings → Security"
else
    echo "${WAIT}Dependabot: config lands via git; then Settings → Security → Dependabot → Enable"
fi

# 5. API key activation ---------------------------------------------------
# The gate is enforcing (witnessed Oct 5, 2026): API_KEY is injected from
# BWS at launch. It legitimately lives in the keychain rather than .env,
# so check both places before calling it missing.
API_KEY_SOURCE=""
if [ -n "${API_KEY:-}" ] && [ "$API_KEY" != "replace-with-a-long-random-password" ]; then
    API_KEY_SOURCE="environment / .env"
else
    KEY_VALUE="$(bash scripts/secrets-keychain get API_KEY 2>/dev/null)"
    [ -n "$KEY_VALUE" ] && API_KEY_SOURCE="login keychain (injected at launch)"
fi
if [ -n "$API_KEY_SOURCE" ]; then
    echo "${OK}API gate: enforcing — API_KEY available (${API_KEY_SOURCE}); unauthenticated /api/* gets 401"
else
    echo "${WAIT}API gate: API_KEY missing from env AND keychain — gate degrades to a no-op; restore via 'scripts/pull-secrets' (BWS) or 'scripts/secrets-keychain put API_KEY'"
fi

# 6. Hygiene reminders ----------------------------------------------------
[ -f triage.db ] && echo "${WAIT}triage.db reappeared in the tree — it was archived to splunk-es-backup-toolkit/ on Sep 25; investigate why it's back"
echo ""
echo "   (read-only check — nothing was changed. Details: docs/security-remediation-tracker.md)"