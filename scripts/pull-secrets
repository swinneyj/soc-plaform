#!/usr/bin/env bash
# scripts/pull-secrets — regenerate .env from Bitwarden Secrets Manager.
#
# Solves the "I wiped my .env" problem permanently: every secret lives in
# BWS as the single source of truth; this script pulls them down and writes
# .env fresh. Values are never printed — only key names are echoed.
#
# Requirements:
#   - `bws` CLI installed (https://bitwarden.com/help/secrets-manager-cli/)
#   - BWS_ACCESS_TOKEN available via:
#       --token-file FILE   (recommended: a 0600 file outside the repo)
#       existing .env       (the usual bootstrap: one line in .env)
#       BWS_ACCESS_TOKEN    environment variable
#   - --project-id ID       (optional but recommended: scope the pull)
#
# What it writes:
#   .env  — BWS secrets (KEY=value lines) + your preserved local-only keys
#           (LOCAL_ONLY_KEYS below). The bootstrap token is preserved too,
#           so the script is safely re-runnable.
#
# Nothing is ever echoed but key names. Use `--dry-run` to preview keys.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ENV_FILE="$ROOT/.env"

# Keys that stay local (not secrets in BWS): keep across regenerations.
LOCAL_ONLY_KEYS="SOC_PLATFORM_ROOT ENABLE_DOCS SOC_PORT"

TOKEN_FILE=""
PROJECT_ID=""
DRY_RUN=0

while [ $# -gt 0 ]; do
    case "$1" in
        --token-file)  TOKEN_FILE="$2"; shift 2 ;;
        --project-id)  PROJECT_ID="$2"; shift 2 ;;
        --dry-run)     DRY_RUN=1; shift ;;
        *) echo "unknown flag: $1" >&2; exit 1 ;;
    esac
done

# ---------------------------------------------------------------- bws binary
if command -v bws >/dev/null 2>&1; then
    BWS="bws"
elif [ -x "$HOME/.local/bin/bws" ]; then
    BWS="$HOME/.local/bin/bws"
else
    echo "✗ bws CLI not found. Install it:" >&2
    echo "    curl https://bws.bitwarden.com/install | sh" >&2
    echo "  (then move the binary somewhere on PATH, e.g. ~/.local/bin)" >&2
    exit 1
fi

# ---------------------------------------------------------------- token
TOKEN_ENV=""
if [ -n "${BWS_ACCESS_TOKEN:-}" ]; then
    TOKEN_ENV="$BWS_ACCESS_TOKEN"
elif [ -f "$ENV_FILE" ]; then
    TOKEN_ENV="$(grep -E '^BWS_ACCESS_TOKEN=' "$ENV_FILE" | tail -1 | cut -d= -f2- || true)"
fi
if [ -n "$TOKEN_FILE" ] && [ -f "$TOKEN_FILE" ]; then
    TOKEN_ENV="$(cat "$TOKEN_FILE")"
fi
if [ -z "$TOKEN_ENV" ]; then
    echo "✗ No BWS_ACCESS_TOKEN found." >&2
    echo "  Provide one via --token-file, the environment, or a line in .env:" >&2
    echo "    BWS_ACCESS_TOKEN=0.xxxx..." >&2
    exit 1
fi
export BWS_ACCESS_TOKEN="$TOKEN_ENV"

# ---------------------------------------------------------------- fetch
echo "→ fetching secret list from Bitwarden Secrets Manager…"
if [ -n "$PROJECT_ID" ]; then
    SECRETS_JSON="$("$BWS" secret list "$PROJECT_ID" 2>/dev/null)"
else
    SECRETS_JSON="$("$BWS" secret list 2>/dev/null)"
fi
if [ -z "$SECRETS_JSON" ]; then
    echo "✗ bws returned nothing — token invalid or no project access." >&2
    echo "  Check with your BWS admin that this machine account can read the project." >&2
    exit 1
fi

# Parse key/value pairs out of bws JSON (keys only ever printed).
PAIRS="$("$BWS" secret list ${PROJECT_ID:+"$PROJECT_ID"} 2>/dev/null | "$ROOT/.venv314/bin/python" -c "
import json, sys
data = json.load(sys.stdin)
secrets = data if isinstance(data, list) else data.get('data', [])
for s in secrets:
    print(s['key'] + '\t' + s['value'].replace(chr(10), ''))
" 2>/dev/null || true)"

if [ -z "$PAIRS" ]; then
    echo "✗ Could not parse secrets (or none accessible to this token)." >&2
    exit 1
fi

# ---------------------------------------------------------------- write
TMP_ENV="$(mktemp)"
trap 'rm -f "$TMP_ENV"' EXIT

# 1. BWS secrets first (injected values win at launch time anyway).
echo "$PAIRS" | while IFS=$'\t' read -r key value; do
    [ -n "$key" ] && printf '%s=%s\n' "$key" "$value" >> "$TMP_ENV"
done

# 2. Preserve local-only keys + the bootstrap token from the current .env.
if [ -f "$ENV_FILE" ]; then
    while IFS= read -r line; do
        case "$line" in
            \#*|"") continue ;;
            BWS_ACCESS_TOKEN=*) printf '%s\n' "$line" >> "$TMP_ENV" ;;
            *)
                key="${line%%=*}"
                case " $LOCAL_ONLY_KEYS " in
                    *" $key "*) printf '%s\n' "$line" >> "$TMP_ENV" ;;
                esac
                ;;
        esac
    done < "$ENV_FILE"
fi

echo "→ secrets pulled (keys only):"
cut -d= -f1 "$TMP_ENV" | grep -v '^$' | sort | sed 's/^/    /'

if [ "$DRY_RUN" -eq 1 ]; then
    echo "→ dry run: .env NOT modified."
    exit 0
fi

chmod 600 "$TMP_ENV"
mv "$TMP_ENV" "$ENV_FILE"
trap - EXIT
echo "✓ .env regenerated at $ENV_FILE (permissions 600)."
echo "  Next: scripts/dev --check   (should report mode: bws)"