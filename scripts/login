#!/usr/bin/env python3
"""Mint a local session for an account and save its cookie for curl.

    scripts/login soc-analyst              # save the cookie jar, print nothing secret
    scripts/login soc-analyst --print-curl # also print a ready-to-paste curl command
    scripts/login soc-analyst --base-url http://127.0.0.1:8000

Two paths, tried in order:

1. **dev-login** — POST /api/auth/dev-login with the armed API key (from the
   environment, else the macOS Keychain). Works when the server runs with
   SOC_DEV_LOGIN=1, which is the local default this repo documents. No password
   is involved.
2. **password login** — POST /api/auth/login with the account's password, read
   from the Keychain (`SOC_<ACCOUNT>_PASSWORD`), for a server that has the dev
   endpoint switched off. The password is never printed, never in argv.

The session cookie is written to ``~/.soc/sessions/<account>.cookies`` (0600,
Mozilla cookie format) so curl can reuse it:

    curl -s -b ~/.soc/sessions/soc-analyst.cookies http://127.0.0.1:8000/api/tools

Nothing secret is printed: no password, no cookie value, no API key. The CSRF
token is printed only with ``--show-csrf`` because mutations need it.
"""

import argparse
import http.cookiejar
import json
import os
import subprocess
import sys
import urllib.error
import urllib.request

SERVICE = "soc-platform"
DEFAULT_BASE = os.environ.get("SOC_LOGIN_BASE_URL", "http://127.0.0.1:8000")


def keychain_get(name: str) -> str:
    """Read a value from the login Keychain without printing it."""
    try:
        out = subprocess.run(
            ["security", "find-generic-password", "-a", name, "-s", SERVICE, "-w"],
            capture_output=True, text=True, check=True,
        )
    except (subprocess.CalledProcessError, FileNotFoundError):
        return ""
    return out.stdout.strip()


def password_name(account: str) -> str:
    """soc-analyst -> SOC_ANALYST_PASSWORD (also honours an exact-name override)."""
    exact = "SOC_%s_PASSWORD" % account.upper().replace("-", "_")
    short = account[4:] if account.startswith("soc-") else account
    derived = "SOC_%s_PASSWORD" % short.upper().replace("-", "_")
    return exact if keychain_get(exact) else derived


def request(base, path, payload, headers=None, jar=None):
    opener = urllib.request.build_opener(
        urllib.request.HTTPCookieProcessor(jar) if jar is not None else urllib.request.HTTPHandler()
    )
    body = json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(
        base.rstrip("/") + path, data=body, method="POST",
        headers={"Content-Type": "application/json", **(headers or {})},
    )
    try:
        with opener.open(req, timeout=10) as resp:
            return resp.status, json.loads(resp.read().decode("utf-8") or "{}")
    except urllib.error.HTTPError as exc:
        try:
            detail = json.loads(exc.read().decode("utf-8") or "{}")
        except ValueError:
            detail = {}
        return exc.code, detail
    except urllib.error.URLError as exc:
        return 0, {"detail": "cannot reach %s: %s" % (base, exc.reason)}


def cookie_path(account: str) -> str:
    home = os.path.expanduser("~")
    directory = os.path.join(home, ".soc", "sessions")
    os.makedirs(directory, mode=0o700, exist_ok=True)
    return os.path.join(directory, "%s.cookies" % account)


def main(argv=None):
    parser = argparse.ArgumentParser(description="mint a local session for an account")
    parser.add_argument("account", help="existing account, e.g. soc-admin or soc-analyst")
    parser.add_argument("--base-url", default=DEFAULT_BASE)
    parser.add_argument("--print-curl", action="store_true",
                        help="print an example curl command using the saved cookie")
    parser.add_argument("--show-csrf", action="store_true",
                        help="print the CSRF token (only needed for mutations over curl)")
    args = parser.parse_args(argv)

    base = args.base_url
    jar = http.cookiejar.MozillaCookieJar(cookie_path(args.account))
    session = None
    method = ""

    api_key = os.environ.get("API_KEY", "").strip() or keychain_get("API_KEY")
    if api_key:
        status, body = request(
            base, "/api/auth/dev-login", {"account": args.account},
            headers={"X-API-Key": api_key}, jar=jar,
        )
        if status == 200:
            session, method = body, "dev-login"
        elif status not in (404,):  # 404 = flag off; fall through to the password path
            print("dev-login refused (%s): %s" % (status, body.get("detail")), file=sys.stderr)

    if session is None:
        name = password_name(args.account)
        password = keychain_get(name)
        if not password:
            print(
                "no session: dev-login is off and no %s in the Keychain.\n"
                "Either run the API with SOC_DEV_LOGIN=1, or store the password:\n"
                "  printf '%%s' \"$PASSWORD\" | scripts/secrets-keychain put %s" % (name, name),
                file=sys.stderr,
            )
            return 2
        status, body = request(
            base, "/api/auth/login",
            {"username": args.account, "password": password}, jar=jar,
        )
        if status != 200:
            print("login failed (%s): %s" % (status, body.get("detail")), file=sys.stderr)
            return 2
        session, method = body, "password"

    path = cookie_path(args.account)
    jar.save(ignore_discard=True, ignore_expires=True)
    os.chmod(path, 0o600)
    print("signed in as %s (role=%s) via %s" % (
        session.get("user", args.account), session.get("role", "?"), method))
    print("cookie jar: %s" % path)
    if args.show_csrf:
        print("csrf: %s" % session.get("csrf_token", ""))
    if args.print_curl:
        print("curl -s -b %s %s/api/auth/session" % (path, base.rstrip("/")))
    return 0


if __name__ == "__main__":
    sys.exit(main())
