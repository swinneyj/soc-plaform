#!/usr/bin/env bash
# scripts/start — one-command startup for the SOC Platform.
#
# Starts every piece the platform needs, in dependency order, idempotently
# (safe to re-run; already-running pieces are detected and left alone):
#
#   1. Ollama (local LLM server, port 11434) — launched only if not running
#   2. Secrets preflight — BWS token + CLI present? (.env fallback per scripts/dev)
#   3. API (uvicorn, port 8000) — daemonized so it survives the launching shell
#      (double-fork/setsid pattern; plain nohup does NOT survive tool-shell
#      teardown on this machine — see AGENTS.md)
#   4. Health verification — /api/health until 200 or fail with log tail
#
# Database: LOCAL Postgres is primary and starts with the platform (the
# Homebrew service); nothing cloud-side is required. The shared Neon project is
# an optional mirror reached with `--shared` (docs/LOCAL_FIRST_DATABASE.md).
#
# Usage:
#   scripts/start              # start everything on local Postgres, verify, exit
#   scripts/start --shared     # same, but target the shared Neon mirror
#   scripts/start --check      # report status of every piece, start nothing
#   scripts/start --stop       # stop the API daemon (Ollama left running)
#   scripts/start --port 8001  # custom API port
#   scripts/start --backup     # force a fresh DB backup + retention report
#
# Exit codes: 0 = all healthy, 1 = something failed (see output).
#
# Phase 5 ops note: there is deliberately NO launchd/cron for backups or
# retention. Ops rides along with platform starts instead — the launcher
# refreshes the DB backup (skipped when the newest dump is < 20h old) and
# writes a retention dry-run report every run. `--backup` forces a fresh
# dump on demand; apply-time pruning stays a manual, deliberate step.

set -euo pipefail

PORT="${SOC_PORT:-8000}"
DO_CHECK=0
DO_STOP=0
DO_BACKUP=0
SHARED_REQUEST=0

while [ $# -gt 0 ]; do
    case "$1" in
        --check) DO_CHECK=1 ;;
        --stop)  DO_STOP=1 ;;
        --backup) DO_BACKUP=1 ;;
        --shared) SHARED_REQUEST=1 ;;
        --port)  PORT="$2"; shift ;;
        *) echo "unknown arg: $1" >&2; exit 1 ;;
    esac
    shift
done

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(dirname "$SCRIPT_DIR")"
cd "$ROOT"

if [ -x ".venv314/bin/python" ]; then
    PY=".venv314/bin/python"
elif [ -x ".venv/bin/python" ]; then
    PY=".venv/bin/python"
else
    PY="python3"
fi

LOG_FILE="/tmp/soc-api.log"
API_BASE="http://127.0.0.1:${PORT}"
API_TIMEOUT_SECS=45

# Both helpers must emit EXACTLY one code. The old `curl … || echo 000` shape
# emitted "000\n000" on a refused connection (curl prints 000 via -w *and*
# fails, so the fallback appended a second one), which made every
# `= "000"` comparison false — `--stop` then reported "still responding" after
# a successful kill, and the wait loop never exited early.
api_health() {
    local code
    code="$(curl -s -o /dev/null -w "%{http_code}" --max-time 5 "${API_BASE}/api/health" 2>/dev/null)" || code="000"
    printf '%s' "${code:-000}"
}

ollama_health() {
    local code
    code="$(curl -s -o /dev/null -w "%{http_code}" --max-time 3 http://127.0.0.1:11434/api/version 2>/dev/null)" || code="000"
    printf '%s' "${code:-000}"
}

report() {
    printf "  %-12s %s\n" "$1" "$2"
}

if [ "$DO_STOP" -eq 1 ]; then
    PIDS="$(pgrep -f 'uvicorn api.main' || true)"
    if [ -n "$PIDS" ]; then
        # kill the whole process group of the daemonized launcher (bws + uvicorn)
        pkill -f "bws run -- .*uvicorn api.main" 2>/dev/null || true
        pkill -f "uvicorn api.main" 2>/dev/null || true
        # Wait for the port to actually close. A fixed 1s sleep raced the
        # process teardown (witnessed Oct 23: "✗ API still responding" then a
        # restart that could not bind), so poll instead of guessing.
        for _ in $(seq 1 20); do
            [ "$(api_health)" = "000" ] && break
            sleep 0.5
        done
    fi
    [ "$(api_health)" = "000" ] && echo "✓ API stopped." || echo "✗ API still responding on :${PORT}" >&2
    exit 0
fi

if [ "$DO_CHECK" -eq 1 ]; then
    # --check is read-only status reporting; it must not start anything
    # (it used to fall through into the API-start branch, a real side effect).
    # .env is only sourced for accurate reporting — no service is touched.
    if [ -f ".env" ]; then
        set -a
        # shellcheck disable=SC1090
        source .env
        set +a
    fi
    # Database target: local Postgres is primary; --shared opts into Neon mirror.
    TARGET="${SOC_DB_TARGET:-local}"
    [ "$SHARED_REQUEST" -eq 1 ] && TARGET="shared"
    # shellcheck source=scripts/lib/db_target.sh
    . "$SCRIPT_DIR/lib/db_target.sh"
    resolve_db_target "$TARGET"
    # Keychain fallback (read-only retrieval) so the API_KEY line is accurate.
    if [ -x "$SCRIPT_DIR/secrets-keychain" ]; then
        eval "$("$SCRIPT_DIR/secrets-keychain" inject 2>/dev/null || true)"
    fi
    OH="$(ollama_health)"
    [ "$OH" = "200" ] && report "ollama" "running (:11434)" || report "ollama" "not running"
    if [ ! -f ".env" ]; then
        report "secrets" "✗ no .env found — run scripts/pull-secrets after BWS setup"
    elif [ "$TARGET" = "shared" ] && [ -n "${BWS_ACCESS_TOKEN:-}" ] && { command -v bws >/dev/null 2>&1 || [ -x "$HOME/.local/bin/bws" ]; }; then
        report "secrets" "BWS mode (token + cli present)"
    elif [ "$TARGET" = "shared" ]; then
        report "secrets" "env/keychain only (.env values, no BWS injection)"
    else
        report "secrets" "keychain/env (local target — BWS deliberately unused)"
    fi
    # Read-only: pg_isready only — --check must never start a service.
    if [ "$TARGET" = "local" ] && command -v pg_isready >/dev/null 2>&1; then
        PG_DSN="$(printf '%s' "$DATABASE_URL" | sed -E 's#^(postgres(ql)?)(\+[^:]+)?:#\1:#')"
        if pg_isready -q -d "$PG_DSN"; then
            report "postgres" "local server accepting connections"
        else
            report "postgres" "✗ service down — 'scripts/start' starts it (brew services start postgresql@16)"
        fi
    fi
    if DB_PING="$("$PY" -m db.target --ping 2>&1)"; then
        report "database" "$DB_SUMMARY ✓ ($DB_PING)"
    else
        report "database" "$DB_SUMMARY ✗ ($DB_PING)"
    fi
    [ "$(api_health)" = "200" ] && report "api" "running (:${PORT})" || report "api" "not running"
    echo "──────────────────────────────────────────────────────"
    exit 0
fi

echo "── SOC Platform startup ──────────────────────────────"

# ── 1. Ollama ────────────────────────────────────────────────────────
if [ "$(ollama_health)" = "200" ]; then
    report "ollama" "already running (:11434)"
else
    if command -v ollama >/dev/null 2>&1; then
        report "ollama" "starting…"
        # Double-fork + setsid (same pattern as the API below): plain nohup
        # does NOT survive tool-shell teardown on this machine — see AGENTS.md.
        python3 - <<'PYEOF'
import os
pid = os.fork()
if pid == 0:
    os.setsid()
    if os.fork() != 0:
        os._exit(0)
    devnull = os.open("/dev/null", os.O_RDONLY)
    log = os.open("/tmp/ollama.log", os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
    os.dup2(devnull, 0); os.dup2(log, 1); os.dup2(log, 2)
    os.execvp("ollama", ["ollama", "serve"])
else:
    os.waitpid(pid, 0)
PYEOF
        for _ in $(seq 1 10); do
            sleep 1
            [ "$(ollama_health)" = "200" ] && break
        done
        [ "$(ollama_health)" = "200" ] && report "ollama" "started (:11434)" \
            || { report "ollama" "✗ failed to start (see /tmp/ollama.log)"; exit 1; }
    else
        report "ollama" "not installed — AI analysis will be unavailable"
        echo "    (install: https://ollama.com — the platform runs without it,"
        echo "     but /api/db/analyze endpoints will 503)"
    fi
fi

# ── 2. Secrets preflight (same contract as scripts/dev) ─────────────────
if [ ! -f ".env" ]; then
    report "secrets" "✗ no .env found — run scripts/pull-secrets after BWS setup"
    exit 1
fi
set -a
# shellcheck disable=SC1090
source .env
set +a
# Database target resolution (same helper as scripts/dev): local Postgres is
# primary, `--shared` opts into the Neon mirror. Runs before keychain injection
# so `inject` only supplies API_KEY in local mode.
TARGET="${SOC_DB_TARGET:-local}"
[ "$SHARED_REQUEST" -eq 1 ] && TARGET="shared"
# shellcheck source=scripts/lib/db_target.sh
. "$SCRIPT_DIR/lib/db_target.sh"
resolve_db_target "$TARGET"

# Keychain fallback: fill unset credential keys (DATABASE_URL, API_KEY) from
# the macOS Keychain (scripts/secrets-keychain). DATABASE_URL is already set for
# the chosen target, so this supplies API_KEY and leaves the target alone.
if [ -x "$SCRIPT_DIR/secrets-keychain" ]; then
    eval "$("$SCRIPT_DIR/secrets-keychain" inject 2>/dev/null || true)"
fi

# `bws run` injects every vault secret as env, which would override the local
# DATABASE_URL — so BWS is only used for the shared target.
if [ "$TARGET" = "shared" ] && [ -n "${BWS_ACCESS_TOKEN:-}" ] && { command -v bws >/dev/null 2>&1 || [ -x "$HOME/.local/bin/bws" ]; }; then
    report "secrets" "BWS mode (token + cli present)"
    BWS_BIN="$(command -v bws || echo "$HOME/.local/bin/bws")"
    if ! "$BWS_BIN" project list >/dev/null 2>&1; then
        report "secrets" "✗ BWS_ACCESS_TOKEN rejected — fix token or drop it from .env"
        exit 1
    fi
else
    if [ "$TARGET" = "shared" ]; then
        report "secrets" "env/keychain only (.env values, no BWS injection)"
    else
        report "secrets" "keychain/env (local target — BWS deliberately unused)"
    fi
    BWS_BIN=""
fi

# ── 2.5 Local Postgres: wake the primary if the service is stopped ──────
# Local is the primary database, so "one-command start" should not fail just
# because the Homebrew service was stopped at reboot. Idempotent (pg_isready
# first) and non-fatal on failure: the DB ping below names the real problem.
if [ "$TARGET" = "local" ]; then
    PG_DSN="$(printf '%s' "$DATABASE_URL" | sed -E 's#^(postgres(ql)?)(\+[^:]+)?:#\1:#')"
    if ! command -v pg_isready >/dev/null 2>&1; then
        report "postgres" "pg_isready unavailable (client tools not on PATH) — relying on the DB ping"
    elif pg_isready -q -d "$PG_DSN"; then
        report "postgres" "local server accepting connections"
    elif command -v brew >/dev/null 2>&1; then
        report "postgres" "not accepting connections — starting postgresql@16…"
        # `brew services start` reports exit 5 on this machine even when the
        # server comes up (stale postmaster.pid / launchd quirk — AGENTS.md).
        # Trust pg_isready and the log, never the exit code.
        brew services start postgresql@16 >/dev/null 2>&1 || true
        for _ in $(seq 1 10); do
            sleep 1
            pg_isready -q -d "$PG_DSN" && break
        done
        if pg_isready -q -d "$PG_DSN"; then
            report "postgres" "started"
        else
            report "postgres" "✗ still not accepting connections (see tail /opt/homebrew/var/log/postgresql@16.log)"
            echo "    stale postmaster.pid? Follow the quirk procedure in AGENTS.md —" >&2
            echo "    confirm no postgres process exists before deleting the lock." >&2
        fi
    else
        report "postgres" "✗ not accepting connections (no brew to start it)"
    fi
fi

if DB_PING="$("$PY" -m db.target --ping 2>&1)"; then
    report "database" "$DB_SUMMARY ✓ ($DB_PING)"
else
    report "database" "$DB_SUMMARY ✗ ($DB_PING)"
    echo "  local target: start Postgres (brew services start postgresql@16) or set LOCAL_DATABASE_URL." >&2
    exit 1
fi

# ── 3. API (idempotent: skip if already healthy) ────────────────────────
if [ "$(api_health)" = "200" ]; then
    report "api" "already running (:${PORT})"
else
    report "api" "starting (daemonized, log: $LOG_FILE)…"
    # Double-fork + setsid so the daemon re-parents to init and survives
    # this shell's teardown. Plain nohup does NOT survive here.
    python3 - "$ROOT" "$PORT" "$LOG_FILE" "$BWS_BIN" <<'PYEOF'
import os, sys
root, port, log_path, bws_bin = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
pid = os.fork()
if pid == 0:
    os.setsid()
    if os.fork() != 0:
        os._exit(0)
    os.chdir(root)
    devnull = os.open("/dev/null", os.O_RDONLY)
    log = os.open(log_path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
    os.dup2(devnull, 0); os.dup2(log, 1); os.dup2(log, 2)
    launcher = f'bash scripts/dev --port {port}' if os.path.basename(bws_bin or "x") != "bws" \
        else f'"{bws_bin}" run -- bash scripts/dev --port {port}'
    os.execvp("bash", ["bash", "-lc", f'cd {root} && exec {launcher}'])
else:
    os.waitpid(pid, 0)
PYEOF
    for _ in $(seq 1 "$((API_TIMEOUT_SECS / 3))"); do
        sleep 3
        [ "$(api_health)" = "200" ] && break
    done
    [ "$(api_health)" = "200" ] && report "api" "started (:${PORT}, pid $(pgrep -f 'uvicorn api.main' | head -1))" \
        || { report "api" "✗ failed to become healthy in ${API_TIMEOUT_SECS}s — log tail:"; tail -10 "$LOG_FILE" >&2; exit 1; }
fi

# ── 3.5 Ops maintenance — Phase 5 without a scheduler ───────────────────
# Every platform start brings the ops pass with it (or --backup forces one):
#   • backup_db.sh — gzipped pg_dump of whatever DATABASE_URL points at, into
#     local-backups/; skipped when the newest dump is < 20h old so restart-heavy
#     days don't multiply dumps. In --shared mode that dump is the mirror, not
#     the primary: run `scripts/start --backup` on the local target to protect
#     the primary.
#   • retention — dry-run report only; apply-time pruning stays manual
#     (RETENTION_APPLY=1 .venv314/bin/python scripts/prune_analysis_results.py --apply).
# Non-fatal by design: a failed backup must never take the platform down.
if [ "$DO_STOP" -eq 0 ]; then
    if [ -x ".venv314/bin/python" ]; then MAINT_PY=".venv314/bin/python"; else MAINT_PY=".venv/bin/python"; fi
    NEWEST_DUMP="$(ls -t "${ROOT}/local-backups"/postgres_dump_*.sql.gz 2>/dev/null | head -1 || true)"
    DUMP_AGE_H=""
    if [ -n "$NEWEST_DUMP" ]; then
        DUMP_AGE_H=$(( ( $(date +%s) - $(stat -f %m "$NEWEST_DUMP") ) / 3600 ))
    fi
    if [ "$DO_BACKUP" != "1" ] && [ -n "$DUMP_AGE_H" ] && [ "$DUMP_AGE_H" -lt 20 ]; then
        report "backup" "fresh (${DUMP_AGE_H}h old) — skipping"
    else
        if [ -n "${BWS_BIN:-}" ]; then
            "$BWS_BIN" run -- bash "$SCRIPT_DIR/backup_db.sh" > /tmp/soc-backup.log 2>&1 \
              && report "backup" "dump complete ($(basename "$(ls -t "${ROOT}/local-backups"/postgres_dump_*.sql.gz 2>/dev/null | head -1)"))" \
              || report "backup" "✗ failed (see /tmp/soc-backup.log)"
        else
            bash "$SCRIPT_DIR/backup_db.sh" > /tmp/soc-backup.log 2>&1 \
              && report "backup" "dump complete" \
              || report "backup" "✗ failed (see /tmp/soc-backup.log)"
        fi
    fi
    # Local mode has no bws binary by design, so run the report directly —
    # otherwise the local-first default would silently drop the ops pass.
    if [ -n "${BWS_BIN:-}" ]; then
        "$BWS_BIN" run -- "$MAINT_PY" scripts/prune_analysis_results.py > /tmp/soc-retention.log 2>&1 \
          && report "retention" "dry-run report (/tmp/soc-retention.log)" \
          || report "retention" "✗ report failed (see /tmp/soc-retention.log)"
    else
        "$MAINT_PY" scripts/prune_analysis_results.py > /tmp/soc-retention.log 2>&1 \
          && report "retention" "dry-run report (/tmp/soc-retention.log)" \
          || report "retention" "✗ report failed (see /tmp/soc-retention.log)"
    fi
fi

# ── 4. Final health summary ──────────────────────────────────────────────
if [ "$DO_CHECK" -eq 1 ]; then
    echo "── status only (nothing was started if already up) ───"
fi
echo "──────────────────────────────────────────────────────"
if [ "$(api_health)" = "200" ]; then
    echo "✓ Platform healthy."
    echo "  API:        ${API_BASE}/api/health"
    echo "  Dashboard:  ${API_BASE}/index.modular.html"
    echo "  Backup now: scripts/start --backup"
    echo "  Stop:       scripts/start --stop"
    echo "  Logs:       tail -f $LOG_FILE"
    exit 0
else
    echo "✗ API unhealthy after startup sequence." >&2
    exit 1
fi
