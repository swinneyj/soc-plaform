#!/usr/bin/env bash
# scripts/secrets-keychain — credential-bearing secrets in the macOS Keychain.
#
# Solves security-tracker #3 ("secrets in plaintext .env"): the keys that
# carry credentials (DATABASE_URL — its password is inside the URL — and
# API_KEY) live in the login keychain instead of .env. .env keeps only the
# bootstrap token, non-secret config, and `# NAME=@keychain` marker comments
# recording what the keychain holds. This also matches the documented
# end-state in AGENTS.md ("`.env` is a bootstrap: token + local-only keys").
#
# Launch precedence (see scripts/dev): BWS-injected values win (bws run),
# then explicit env / .env values, then keychain values (via inject).
#
# Usage:
#   scripts/secrets-keychain put NAME     # value read from stdin (never echoed)
#   scripts/secrets-keychain get NAME     # prints the stored value (one line)
#   scripts/secrets-keychain delete NAME
#   scripts/secrets-keychain list         # marker names + keychain presence
#   scripts/secrets-keychain inject       # emits `export NAME=...` lines for
#                                         # every `# NAME=@keychain` marker
#                                         # whose name is not already set;
#                                         # launchers eval this
#   scripts/secrets-keychain migrate      # move the credential keys currently
#                                         # in .env into the keychain and leave
#                                         # markers behind (safe to re-run)
#
# Values are never printed except by `get` (that is its job); every other
# subcommand prints names only.

set -euo pipefail

SERVICE="soc-platform"
# Keys whose values carry credentials (tracker #3). POSTGRES_PASSWORD and
# COMPOSE_DATABASE_URL are included defensively: if a future pull-secrets run
# reintroduces them, they migrate too. Note for Docker flows: compose reads
# .env via interpolation (it does not run `inject`), so export the value from
# the keychain first:  export POSTGRES_PASSWORD="$(scripts/secrets-keychain get POSTGRES_PASSWORD)"
KEYCHAIN_KEYS="DATABASE_URL API_KEY POSTGRES_PASSWORD COMPOSE_DATABASE_URL SPLUNK_TOKEN"
# SPLUNK_TOKEN (Phase 3 live Splunk connector) rides the same chain: BWS →
# pull-secrets → migrate. SPLUNK_URL and SEARCH_BACKEND are non-secret config
# and stay as plain .env/BWS values.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(dirname "$SCRIPT_DIR")"
ENV_FILE="$ROOT/.env"

die() { echo "✗ $*" >&2; exit 1; }

need_keychain() {
    [ "$(uname -s)" = "Darwin" ] || die "macOS Keychain not available on $(uname -s)"
    command -v security >/dev/null 2>&1 || die "macOS 'security' CLI not found"
}

marker_names() {
    # Names recorded as `# NAME=@keychain` marker comments (see migrate).
    [ -f "$ENV_FILE" ] || return 0
    grep -E '^# [A-Za-z_][A-Za-z0-9_]*=@keychain' "$ENV_FILE" \
        | sed -E 's/^# ([A-Za-z_][A-Za-z0-9_]*)=@keychain.*/\1/' || true
}

store() {
    # -U updates an existing item; -T lets /usr/bin/security read it back
    # without an interactive ACL prompt.
    security add-generic-password -U -a "$1" -s "$SERVICE" -w "$2" -T /usr/bin/security >/dev/null
}

cmd="${1:-}"
case "$cmd" in
    put)
        name="${2:-}"; [ -n "$name" ] || die "usage: put NAME   (value on stdin)"
        need_keychain
        value="$(cat)"
        [ -n "$value" ] || die "empty value on stdin"
        store "$name" "$value"
        echo "✓ stored $name (keychain service: $SERVICE)"
        ;;
    get)
        name="${2:-}"; [ -n "$name" ] || die "usage: get NAME"
        need_keychain
        security find-generic-password -a "$name" -s "$SERVICE" -w
        ;;
    delete)
        name="${2:-}"; [ -n "$name" ] || die "usage: delete NAME"
        need_keychain
        security delete-generic-password -a "$name" -s "$SERVICE" >/dev/null 2>&1 \
            || die "$name not found in keychain"
        echo "✓ deleted $name"
        ;;
    list)
        need_keychain
        while IFS= read -r name; do
            [ -n "$name" ] || continue
            if security find-generic-password -a "$name" -s "$SERVICE" >/dev/null 2>&1; then
                printf '  %s  ok\n' "$name"
            else
                printf '  %s  MISSING (run scripts/secrets-keychain migrate)\n' "$name"
            fi
        done <<< "$(marker_names)"
        ;;
    inject)
        # Launcher hook: fill unset secrets from markers. Emits shell syntax
        # only (`export NAME=...`), so callers do:  eval "$(... inject)"
        command -v security >/dev/null 2>&1 || exit 0
        while IFS= read -r name; do
            [ -n "$name" ] || continue
            eval "current=\${$name:-}"
            [ -n "$current" ] && continue
            value="$(security find-generic-password -a "$name" -s "$SERVICE" -w 2>/dev/null)" || continue
            [ -n "$value" ] || continue
            printf 'export %s=%q\n' "$name" "$value"
        done <<< "$(marker_names)"
        ;;
    migrate)
        need_keychain
        [ -f "$ENV_FILE" ] || die "no .env at $ENV_FILE"
        # Read current values exactly the way the launchers do.
        set -a
        # shellcheck disable=SC1090
        . "$ENV_FILE"
        set +a
        tmp="$(mktemp)"
        moved=""
        while IFS= read -r line; do
            key=""
            case "$line" in
                [A-Za-z_]*) key="${line%%=*}" ;;
            esac
            case " $KEYCHAIN_KEYS " in
                *" $key "*)
                    value="${!key:-}"
                    if [ -n "$value" ]; then
                        store "$key" "$value"
                        moved="$moved $key"
                        printf '# %s=@keychain (macOS Keychain service: %s)\n' "$key" "$SERVICE" >> "$tmp"
                        continue
                    fi
                    ;;
            esac
            printf '%s\n' "$line" >> "$tmp"
        done < "$ENV_FILE"
        chmod 600 "$tmp"
        mv "$tmp" "$ENV_FILE"
        if [ -n "$moved" ]; then
            echo "✓ moved to keychain:$moved"
            echo "  .env now keeps markers + non-secret keys only (values never printed)."
        else
            echo "✓ nothing to migrate (no plain $KEYCHAIN_KEYS values found in .env)."
        fi
        ;;
    *)
        die "usage: secrets-keychain {put|get|delete|list|inject|migrate} [NAME]"
        ;;
esac
