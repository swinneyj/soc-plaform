#!/usr/bin/env bash
# scripts/dev — SOC Platform development launcher.
#
# Launches uvicorn against **local Postgres by default**, with BWS/keychain
# providing only the secrets a local run needs (API_KEY). The shared Neon
# mirror is opt-in (`--shared`) so a Neon free-tier storage/egress ceiling can
# never stop the platform from running.
#
# Database target (`python -m db.target` is the single source of truth):
#   local     default — DATABASE_URL from LOCAL_DATABASE_URL if set, else the
#             built-in 127.0.0.1:5432 URL. BWS is NOT used for this mode,
#             because `bws run` would inject its DATABASE_URL (Neon) over it.
#   shared    `--shared` or SOC_DB_TARGET=shared — SHARED_DATABASE_URL from
#             env/BWS/keychain; BWS injection is allowed again.
#   explicit  DATABASE_URL set by the operator always wins; the launcher warns
#             when that overrides a local target.
#
# Usage:
#   scripts/dev                 # local Postgres (primary), port 8000
#   scripts/dev --shared        # shared Neon mirror instead
#   scripts/dev --check         # detect mode + DB target, launch nothing
#   scripts/dev --port 8001     # custom port
#   scripts/dev -- --log-level debug   # extra args after -- go to uvicorn
#
# Env vars honored:
#   SOC_PORT             default port (8000)
#   SOC_DB_TARGET        local|shared (default local)
#   LOCAL_DATABASE_URL   override the local URL (e.g. compose: :5433)
#   SHARED_DATABASE_URL  the Neon URL for --shared
#   DATABASE_URL         explicit override — wins over the target
#   BWS_ACCESS_TOKEN     set in .env only when the shared path is wanted
#   ENABLE_DOCS=1        keep Swagger UI in local dev (prod has it disabled)

set -euo pipefail

PORT="${SOC_PORT:-8000}"
EXTRA_ARGS=()
CHECK_ONLY=0
SHARED_REQUEST=0

while [ $# -gt 0 ]; do
    case "$1" in
        --check)   CHECK_ONLY=1; shift ;;
        --shared)  SHARED_REQUEST=1; shift ;;
        --port)    PORT="$2"; shift 2 ;;
        --)        shift; EXTRA_ARGS=("$@"); break ;;
        *)         EXTRA_ARGS+=("$1"); shift ;;
    esac
done

# Resolve repo root (two levels up from this script) so it works from anywhere.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(dirname "$SCRIPT_DIR")"
cd "$ROOT"

# Pick the newest venv automatically (3.14 preferred, 3.9 legacy fallback).
if [ -x ".venv314/bin/python" ]; then
    PY=".venv314/bin/python"
elif [ -x ".venv/bin/python" ]; then
    PY=".venv/bin/python"
else
    echo "✗ No virtualenv found (.venv314 or .venv). Create one first." >&2
    exit 1
fi

# Load .env into the environment (keys only — values never echoed).
ENV_FILE="$ROOT/.env"
HAVE_TOKEN=0
if [ -f "$ENV_FILE" ]; then
    set -a
    # shellcheck disable=SC1090
    source "$ENV_FILE"
    set +a
    if [ -n "${BWS_ACCESS_TOKEN:-}" ]; then
        HAVE_TOKEN=1
    fi
else
    echo "⚠ No .env found at $ENV_FILE — continuing with environment only." >&2
fi

# ── Database target ─────────────────────────────────────────────────────
# Local Postgres is primary; `--shared` opts into the Neon mirror. Resolution
# lives in scripts/lib/db_target.sh (shared with scripts/start), and it runs
# *before* keychain injection so `inject` keeps its hands off DATABASE_URL and
# only supplies API_KEY.
TARGET="${SOC_DB_TARGET:-local}"
[ "$SHARED_REQUEST" -eq 1 ] && TARGET="shared"
# shellcheck source=scripts/lib/db_target.sh
. "$SCRIPT_DIR/lib/db_target.sh"
resolve_db_target "$TARGET"
TARGET="$DB_TARGET"

# Keychain fallback: fill unset credential keys (DATABASE_URL, API_KEY) from
# the macOS Keychain (scripts/secrets-keychain). DATABASE_URL is already set
# above in both target modes, so this supplies API_KEY and leaves the target
# alone.
if [ -x "$SCRIPT_DIR/secrets-keychain" ]; then
    eval "$("$SCRIPT_DIR/secrets-keychain" inject 2>/dev/null || true)"
fi

if command -v bws >/dev/null 2>&1; then
    BWS_BIN="bws"
elif [ -x "$HOME/.local/bin/bws" ]; then
    BWS_BIN="$HOME/.local/bin/bws"
    export PATH="$HOME/.local/bin:$PATH"
else
    BWS_BIN=""
fi

# `bws run` injects every vault secret as env, which would override the local
# DATABASE_URL — so BWS is only usable in shared mode (its purpose there is
# the Neon URL and the Splunk token).
MODE="env-only"
if [ "$TARGET" = "shared" ] && [ "$HAVE_TOKEN" -eq 1 ] && [ -n "$BWS_BIN" ]; then
    MODE="bws"
fi

# Local schema bootstrap: additive CREATE TABLE only (never a drop/alter), so
# a local database that predates a model (users/auth_sessions) starts working
# without a manual migration. Shared is never touched here.
SCHEMA_NOTE=""
if [ "$TARGET" = "local" ]; then
    if ! SCHEMA_NOTE="$($PY -m db.schema 2>&1)"; then
        echo "✗ local schema bootstrap failed — $SCHEMA_NOTE" >&2
        exit 1
    fi
fi

# Read-only preflight: fail here with a named target instead of deep inside a
# half-launched server. Shared mode may be slow (Neon wakes compute).
if ! DB_PING="$($PY -m db.target --ping 2>&1)"; then
    echo "✗ database unreachable — $DB_PING" >&2
    echo "  local target: start Postgres (brew services start postgresql@16) or set LOCAL_DATABASE_URL." >&2
    echo "  shared target: check SHARED_DATABASE_URL / BWS credentials." >&2
    exit 1
fi

echo "── SOC Platform launcher ─────────────────────────────"
echo "  mode:        $MODE"
echo "  db target:   ${DB_SUMMARY:-$TARGET}"
echo "  db status:   $DB_PING"
[ -n "$SCHEMA_NOTE" ] && echo "  schema:      $SCHEMA_NOTE"
echo "  python:      $($PY --version 2>&1) ($PY)"
echo "  port:        $PORT"
if [ "$MODE" = "bws" ]; then
    echo "  bws cli:     $BWS_BIN"
elif [ "$TARGET" = "shared" ]; then
    [ "$HAVE_TOKEN" -eq 0 ] && echo "  bws:         no BWS_ACCESS_TOKEN in .env (shared URL must come from keychain/.env)"
    [ -z "$BWS_BIN" ] && [ "$HAVE_TOKEN" -eq 1 ] && echo "  bws:         token found but bws CLI missing (use the bws installer)"
else
    echo "  bws:         skipped for the local target (vault would override DATABASE_URL)"
fi
echo "──────────────────────────────────────────────────────"

if [ "$CHECK_ONLY" -eq 1 ]; then
    exit 0
fi

if [ "$MODE" = "bws" ]; then
    # Pre-flight: a bad token should die here with guidance, not deep inside
    # a half-launched server (bws's own error for this is a terse 'Error: ').
    if ! "$BWS_BIN" project list >/dev/null 2>&1; then
        echo "✗ BWS_ACCESS_TOKEN rejected (invalid, expired, or no project access)." >&2
        echo "  Launching with .env values only would hide missing secrets — fix the" >&2
        echo "  token first (ask your BWS admin), or remove BWS_ACCESS_TOKEN from .env" >&2
        echo "  to run in env-only mode." >&2
        exit 1
    fi
fi

if [ "$MODE" = "bws" ]; then
    exec "$BWS_BIN" run -- "$PY" -m uvicorn api.main:app --host 127.0.0.1 --port "$PORT" "${EXTRA_ARGS[@]+"${EXTRA_ARGS[@]}"}"
else
    exec "$PY" -m uvicorn api.main:app --host 127.0.0.1 --port "$PORT" "${EXTRA_ARGS[@]+"${EXTRA_ARGS[@]}"}"
fi
